# ICQ1.0 – Docker settings. Copy to .env and fill in (or run: make env).
# .env holds secrets and is never committed.

# Ports on this computer (bound to 127.0.0.1 only)
APP_PORT=8080
MAIL_UI_PORT=8025

# Address used in e-mailed links (password reset)
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Europe/Prague
MAIL_FROM=no-reply@icq1.local

# Database (the database name is fixed: uin_mail)
DB_USER=uin_app
DB_PASS=
DB_ROOT_PASS=

# Encryption keys: base64 of 32 random bytes each, and they must differ.
# Generate with:  openssl rand -base64 32
# Back them up. Losing UIN_ENC_KEY makes all encrypted data unreadable.
UIN_ENC_KEY=
UIN_HMAC_KEY=
